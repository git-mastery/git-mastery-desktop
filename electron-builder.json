{
  "appId": "com.nus.gitmastery",
  "directories": {
    "buildResources": "resources"
  },
  "icon": "icon.png",
  "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
  "files": ["dist-react", "dist-electron"],
  "win": {
    "target": ["portable", "msi"]
  },
  "linux": {
    "target": ["AppImage", "deb"]
  },
  "mac": {
    "target": "dmg"
  }
}
